ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scrapmart
JWT_SECRET=change-me-to-a-long-random-string
# Frontend dev servers allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
API_PREFIX=/api/v1
PUBLIC_BASE_URL=http://localhost:8000
AUTO_CREATE_TABLES=true
# GOOGLE_CLIENT_ID=
# S3_BUCKET=

# Redis Configuration (Optional, e.g. Upstash TLS)
# MAP_REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379
# REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379
# REDIS_CACHE_URL=rediss://default:TOKEN@HOST.upstash.io:6379
# REDIS_FALLBACK_URL=rediss://default:TOKEN@HOST.upstash.io:6379
