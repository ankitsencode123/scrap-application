# ==============================================================================
# SCRAPMART BACKEND - RENDER PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy and paste these key-value pairs into your Render Web Service Dashboard:
# Service Settings -> Environment -> Add Environment Variable (or Secret File)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
ENV=production
PORT=10000
API_PREFIX=/api/v1

# The public URL where this backend service is hosted on Render
# Replace 'your-scrapmart-api' with your actual Render service name
PUBLIC_BASE_URL=https://your-scrapmart-api.onrender.com

# Allowed frontend origins (comma-separated, NO trailing slashes)
# Add your production frontend domain (e.g., Vercel, Netlify, Lovable, or Render)
CORS_ORIGINS=https://your-scrapmart-frontend.vercel.app,https://your-scrapmart-frontend.onrender.com,http://localhost:5173,http://localhost:3000

# Automatically ensure database tables & indexes exist on startup
AUTO_CREATE_TABLES=true

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Replace with a high-entropy 64+ character random string for production
JWT_SECRET=6f0a3e8c9b2d1f4a5e7c8b0d2e4f6a8b1c3d5e7f9a0b2c4d6e8f0a2b4c6d8e0f
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
CURSOR_SECRET=6f0a3e8c9b2d1f4a5e7c8b0d2e4f6a8b1c3d5e7f9a0b2c4d6e8f0a2b4c6d8e0f

# Google OAuth 2.0 Credentials (matches your Google Cloud Console registered origins)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# ------------------------------------------------------------------------------
# 3. DATABASE & MULTI-SHARD CONFIGURATION
# ------------------------------------------------------------------------------
# Primary fallback database URL (if sharding is disabled or single-node)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scrapmart

# Dedicated Realtime Supabase Database for Instant Chat
CHAT_DATABASE_URL=postgresql://postgres.khdbvhcdvtqmreatcssb:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Multi-Shard Database Poolers (6 Shards x 500 MB)
SHARD_DB_PASSWORD=[YOUR-PASSWORD]
SHARD_URLS=postgresql://postgres.ygvjtmnswtfftqwwzawo:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres,postgresql://postgres.cvhqrkecrsebihcsxork:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres,postgresql://postgres.sfpdvvrmobdacdrptynr:[YOUR-PASSWORD]@aws-1-ca-central-1.pooler.supabase.com:5432/postgres,postgresql://postgres.wtedtqoluirroetyzxpc:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres,postgresql://postgres.ifryxodclhfjdomuvnav:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres,postgresql://postgres.rnaojscyyssridxyjyvv:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SHARD_DIRECTORY_SHARDS=0,1,2,3,4,5
SHARD_QUOTA_MB=500
SHARD_SSLMODE=require

# Shard connection pooling & resilience (tuned for Render cloud workers & Supabase poolers)
SHARD_POOL_SIZE=5
SHARD_MAX_OVERFLOW=10
SHARD_POOL_TIMEOUT=30
SHARD_CONNECT_TIMEOUT=15
SHARD_STATEMENT_TIMEOUT_MS=30000
SHARD_SCATTER_TIMEOUT=30
SHARD_STATS_INTERVAL=60
SHARD_BREAKER_THRESHOLD=5

# ------------------------------------------------------------------------------
# 4. REDIS CLOUD & REAL-TIME WEBSOCKET BUS (UPSTASH)
# ------------------------------------------------------------------------------
# Primary Redis: Live GPS tracking, geo-indexing, WebSocket pub/sub fanout
MAP_REDIS_URL=rediss://default:gQAAAAAAApKoAAIgcDEwMWFhNDNjZTcyMDg0MGMwOTY3N2U0YzU4NjVmOWZlZg@genuine-cicada-168616.upstash.io:6379

# Secondary Redis: App caching, shard directory lookup, scrap rate cache
REDIS_URL=rediss://default:gQAAAAAAAvCQAAIgcDFlMTVlOTk5YWQzYWU0MTFjODBjMjcxYWJlYmFjODc1OQ@massive-mantis-192656.upstash.io:6379
REDIS_CACHE_URL=rediss://default:gQAAAAAAAvCQAAIgcDFlMTVlOTk5YWQzYWU0MTFjODBjMjcxYWJlYmFjODc1OQ@massive-mantis-192656.upstash.io:6379

# High-availability cross-instance failover redundancy
REDIS_FALLBACK_URL=rediss://default:gQAAAAAAApKoAAIgcDEwMWFhNDNjZTcyMDg0MGMwOTY3N2U0YzU4NjVmOWZlZg@genuine-cicada-168616.upstash.io:6379
MAP_REDIS_FALLBACK_URL=rediss://default:gQAAAAAAAvCQAAIgcDFlMTVlOTk5YWQzYWU0MTFjODBjMjcxYWJlYmFjODc1OQ@massive-mantis-192656.upstash.io:6379

# ------------------------------------------------------------------------------
# 5. MAP & ROUTING ENGINE
# ------------------------------------------------------------------------------
MAP_DEFAULT_CENTER=28.6139,77.2090
MAP_PRESENCE_TTL_S=120
MAP_MAX_LIVE_ACCURACY_M=300
MAP_MAX_SPEED_KMH=160
MAP_AUTO_ARRIVE=false
MAP_TRUST_PROXY_HEADERS=true
MAP_OSRM_URL=https://router.project-osrm.org

# ------------------------------------------------------------------------------
# 6. STORAGE & MEDIA UPLOADS (SUPABASE OBJECT STORAGE)
# ------------------------------------------------------------------------------
# Supabase Persistent Cloud Storage (Active by default using your Supabase credentials!)
# Storage Bucket: scrapmart-media (public bucket in khdbvhcdvtqmreatcssb)
SUPABASE_URL=https://khdbvhcdvtqmreatcssb.supabase.co
SUPABASE_STORAGE_BUCKET=scrapmart-media

# Optional: Add your Supabase service_role or anon key from Project Settings -> API
# If omitted, media is automatically persisted permanently into Supabase database (public.media_files)
SUPABASE_KEY=

# Image upload constraints & privacy masking
MASK_ADDRESS_FOR_PUBLIC=true
MIN_LISTING_IMAGES=1
MAX_LISTING_IMAGES=6
MAX_IMAGE_MB=8

# Optional: Supabase S3 Gateway (Project Settings -> Storage -> S3 Credentials)
# S3_BUCKET=scrapmart-media
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://khdbvhcdvtqmreatcssb.supabase.co/storage/v1/s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://khdbvhcdvtqmreatcssb.supabase.co/storage/v1/object/public/scrapmart-media

# Local disk fallback (only used if Supabase and S3 are not configured)
LOCAL_UPLOAD_DIR=./uploads

